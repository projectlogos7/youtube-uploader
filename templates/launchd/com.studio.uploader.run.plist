<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  OPTIONAL scheduled runner. Installed as a LaunchAgent of the restricted user
  (_ytuploader) by scripts/install_launchd.sh. It runs `run live if-active`
  every 15 minutes:
    * not activated, or nothing released  -> exits at once, no API call
    * otherwise it uploads ONLY videos the reviewer approved AND released, within
      the activation's scope, upload count and expiry, always as Private.
  The kill switch stops it before the next request. Unload with
  `launchctl bootout gui/$(id -u _ytuploader)/com.studio.uploader.run`.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.studio.uploader.run</string>
  <key>ProgramArguments</key>
  <array>
    <string>__VENV__/bin/studio-uploader</string>
    <string>--config</string><string>__HOME__/.config/studio-uploader/config.toml</string>
    <string>run</string><string>--live</string><string>--if-active</string>
  </array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>__HOME__/StudioUploader/logs/launchd-run.out</string>
  <key>StandardErrorPath</key><string>__HOME__/StudioUploader/logs/launchd-run.err</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
</dict>
</plist>
