<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  OPTIONAL staging watcher: reruns `scan notify` whenever the staging folder
  changes, so the reviewer is told when a finished render is ready for a
  manifest. It never prepares, approves or uploads anything.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.studio.uploader.scan</string>
  <key>ProgramArguments</key>
  <array>
    <string>__VENV__/bin/studio-uploader</string>
    <string>--config</string><string>__HOME__/.config/studio-uploader/config.toml</string>
    <string>scan</string><string>--notify</string>
  </array>
  <key>WatchPaths</key><array><string>__STAGING__</string></array>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>__HOME__/StudioUploader/logs/launchd-scan.out</string>
  <key>StandardErrorPath</key><string>__HOME__/StudioUploader/logs/launchd-scan.err</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
</dict>
</plist>
